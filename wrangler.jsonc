{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beacon",
  "compatibility_date": "2024-04-01",
  "main": "dist/worker-build/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "DASH_KV",
      "id": "ea5e590c0bd749b0acd7fe941cc9b706"
    }
  ],
  // D1: the arm-free agent's state, events (Discord), playtime, snapshots and restore jobs.
  // Schema lives in migrations/: npx wrangler d1 migrations apply beacon-agent --remote
  "d1_databases": [
    {
      "binding": "DASH_DB",
      "database_name": "beacon-agent",
      "database_id": "eabc4e41-2f5a-4c05-830a-4b3e8bb53713",
      "migrations_dir": "migrations"
    }
  ]
  // World saves in Cloudflare R2: create the bucket first (npx wrangler r2 bucket create beacon-backups),
  // then uncomment this (and add a comma after the d1_databases block above).
  // "r2_buckets": [
  //   {
  //     "binding": "BACKUP_BUCKET",
  //     "bucket_name": "beacon-backups"
  //   }
  // ]
}
