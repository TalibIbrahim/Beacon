# Beacon backup agent on arm-free. Copy to ~/.config/beacon/agent.env and run:
#   chmod 600 ~/.config/beacon/agent.env
# KEY=value lines only (no spaces around =, no `export`). Nothing in this file is executed.

# The dashboard, no trailing slash
BEACON_URL=https://beacon.example.workers.dev
# Same value as the AGENT_TOKEN secret in Beacon (openssl rand -hex 32)
AGENT_TOKEN=
# Object Storage pre-authenticated request with write access; ends in /o/
UPLOAD_URL=

# Optional (defaults shown). Comments go on their own line, never after a value.
# PREMIUM_SSH=ubuntu@10.0.0.16
# tmux session running the server; set it empty (MC_TMUX_SESSION=) to skip save-off / save-all flush
# MC_TMUX_SESSION=mc
# MC_REMOTE_DIR=/home/ubuntu/minecraft
# BACKUP_ROOT=/home/ubuntu/mc-backup
# BACKUP_CMD=/home/ubuntu/mc-backup.sh
# Minecraft-Premium's private IP and port, for the status probe (scripts/mc-probe.py)
# MC_HOST=10.0.0.16
# MC_PORT=25565
# Where a restore keeps the replaced world on Minecraft-Premium (the last 2 are kept)
# PRE_RESTORE_DIR=/home/ubuntu/mc-pre-restore
# RCON (TPS, MSPT, full player list). Same password as rcon.password on Minecraft-Premium.
# Only arm-free may reach port 25575: see the README, "Set up RCON".
# RCON_PASSWORD=
# RCON_PORT=25575
