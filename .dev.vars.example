# Oracle Cloud Infrastructure (OCI) credentials
OCI_TENANCY_OCID=<your-tenancy-ocid>
OCI_USER_OCID=<your-user-ocid>
OCI_FINGERPRINT=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00
# Base64 of the PKCS#8 private key (see README, "OCI API key")
OCI_PRIVATE_KEY_B64=<your-base64-encoded-pkcs8-private-key>
OCI_REGION=me-dubai-1
OCI_INSTANCE_OCID=<your-instance-ocid>
OCI_COMPARTMENT_OCID=<your-compartment-ocid>

# Sign-in
# Generate with: npm run hash-password "your-strong-password"
PASSWORD_HASH=pbkdf2$100000$<salt>$<hash>
# Random secret of 32+ characters for signing session cookies
SESSION_SECRET=change-this-to-a-very-secure-random-secret-string-at-least-32-chars

# Optional: when the Oracle free trial ends (ISO 8601, UTC). Leave out to hide the countdown.
TRIAL_END=2099-12-31T00:00:00Z

# Optional: world save download. Pick one (see README, "World saves"):
#   - an R2 bucket bound as BACKUP_BUCKET (local dev: --r2 BACKUP_BUCKET=beacon-backups), or
#   - an Oracle Object Storage pre-authenticated request URL, ending in /o/ for a bucket link
# BACKUP_URL=https://objectstorage.me-dubai-1.oraclecloud.com/p/<token>/n/<namespace>/b/<bucket>/o/

# Optional: backups from arm-free (mc-agent.sh). Needs the AGENT_DB D1 binding too
# (local dev: --d1 AGENT_DB). Same value as AGENT_TOKEN in arm-free's agent.env; 32+ characters.
# AGENT_TOKEN=<openssl rand -hex 32>

# Optional: secret path segment for the direct-from-VM fallback (must match the VM's VM_BACKUP_TOKEN)
# VM_BACKUP_TOKEN=<random-string>

# Optional: Cloudflare Turnstile bot check on the sign-in screen
# TURNSTILE_SITEKEY=<turnstile-site-key>
# TURNSTILE_SECRET=<turnstile-secret-key>
